# backend/main.py
# Complete FastAPI Backend for CCTV YOLO11s Vehicle Tracking System

from fastapi import FastAPI, WebSocket, WebSocketDisconnect
from fastapi.middleware.cors import CORSMiddleware
import cv2
import numpy as np
from ultralytics import YOLO
import asyncio
import json
import base64
from datetime import datetime
from collections import defaultdict
from typing import Dict, List, Set
import threading
from queue import Queue

app = FastAPI()

# CORS middleware for React frontend
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:3000", "http://localhost:5173"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# In-memory storage (easy to migrate to database later)
class VehicleCounter:
    def __init__(self):
        self.vehicle_counts = defaultdict(lambda: {
            'car': 0, 'bus': 0, 'truck': 0, 'motorcycle': 0
        })
        self.tracked_ids = defaultdict(set)  # region_id -> set of track_ids
        self.region_stats = {}
        self.minute_data = []
        self.last_minute = None
        
    def reset_minute(self):
        """Reset counts for new minute"""
        self.vehicle_counts.clear()
        self.tracked_ids.clear()
        
    def add_vehicle(self, region_id: str, vehicle_class: str, track_id: int):
        """Add vehicle if not already counted in this region"""
        if track_id not in self.tracked_ids[region_id]:
            self.tracked_ids[region_id].add(track_id)
            self.vehicle_counts[region_id][vehicle_class] += 1
            return True
        return False
    
    def get_total_counts(self):
        """Combine counts from all regions"""
        total = {'car': 0, 'bus': 0, 'truck': 0, 'motorcycle': 0}
        for region_counts in self.vehicle_counts.values():
            for vehicle_type in total.keys():
                total[vehicle_type] += region_counts[vehicle_type]
        return total
    
    def get_region_stats(self):
        """Get stats for each region"""
        return dict(self.vehicle_counts)

counter = VehicleCounter()

class CCTVProcessor:
    def __init__(self):
        self.model = None
        self.cap = None
        self.model_size = 's'
        self.source_type = 'rtsp'
        self.source = None
        self.regions = []
        self.running = False
        self.frame_queue = Queue(maxsize=2)
        
    def load_model(self, model_size='s', custom_weights=None):
        """Load YOLO11 model"""
        try:
            if custom_weights and custom_weights.strip():
                self.model = YOLO(custom_weights)
                print(f"Loaded custom weights: {custom_weights}")
            else:
                model_path = f'model/yolo11{model_size}.pt'
                self.model = YOLO(model_path)
                print(f"Loaded pre-trained YOLO11{model_size}")
            return True
        except Exception as e:
            print(f"Error loading model: {e}")
            return False
    
    def open_source(self, source_type, source):
        """Open video source (RTSP or file)"""
        try:
            if self.cap:
                self.cap.release()
            
            if source_type == 'rtsp':
                self.cap = cv2.VideoCapture(source)
                # RTSP optimizations
                self.cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
            else:
                # File source - normalize path
                # Example hardcoded path for testing
                source = "C:/Users/Woori/Downloads/L030032.mp4"
                source = source.replace('\\', '/')
                self.cap = cv2.VideoCapture(source)
            
            if not self.cap.isOpened():
                print(f"Failed to open source: {source}")
                return False
            
            print(f"Opened {source_type} source: {source}")
            return True
        except Exception as e:
            print(f"Error opening source: {e}")
            return False
    
    def point_in_region(self, x, y, region):
        """Check if point is inside region"""
        return (region['x'] <= x <= region['x'] + region['w'] and
                region['y'] <= y <= region['y'] + region['h'])
    
    def process_frame(self):
        """Process single frame with YOLO tracking"""
        if not self.cap or not self.model:
            return None, []
        
        ret, frame = self.cap.read()
        if not ret:
            return None, []
        
        # Resize to 1920x1080
        # frame = cv2.resize(frame, (1920, 1080))
        
        # Run YOLO tracking
        results = self.model.track(
            frame,
            imgsz=640,
            persist=True,
            classes=[2, 3, 5, 7],  # car, motorcycle, bus, truck
            verbose=False
        )
        
        detections = []
        class_names = {2: 'car', 3: 'motorcycle', 5: 'bus', 7: 'truck'}
        
        if results[0].boxes.id is not None:
            boxes = results[0].boxes.xyxy.cpu().numpy()
            track_ids = results[0].boxes.id.cpu().numpy().astype(int)
            classes = results[0].boxes.cls.cpu().numpy().astype(int)
            
            for box, track_id, cls in zip(boxes, track_ids, classes):
                x1, y1, x2, y2 = box
                cx, cy = (x1 + x2) / 2, (y1 + y2) / 2
                vehicle_class = class_names.get(cls, 'unknown')
                
                # Determine which regions contain this vehicle
                if len(self.regions) == 0:
                    # No regions = track entire frame
                    counter.add_vehicle('global', vehicle_class, track_id)
                else:
                    # Check each region
                    for idx, region in enumerate(self.regions):
                        region_id = region['id']
                        if self.point_in_region(cx, cy, region):
                            counter.add_vehicle(str(region_id), vehicle_class, track_id)
                
                detections.append({
                    'x': int(x1),
                    'y': int(y1),
                    'w': int(x2 - x1),
                    'h': int(y2 - y1),
                    'class': vehicle_class,
                    # 'track_id': track_id
                    'track_id': int(track_id)
                })
        
        # Encode frame to base64
        _, buffer = cv2.imencode('.jpg', frame, [cv2.IMWRITE_JPEG_QUALITY, 80])
        frame_base64 = base64.b64encode(buffer).decode('utf-8')
        
        return frame_base64, detections
    
    def update_regions(self, regions):
        """Update tracking regions"""
        self.regions = regions
        print(f"Updated regions: {len(regions)} regions")

processor = CCTVProcessor()

@app.websocket("/ws")
async def websocket_endpoint(websocket: WebSocket):
    await websocket.accept()
    print("WebSocket client connected")
    
    try:
        while True:
            # Receive messages from frontend
            try:
                data = await asyncio.wait_for(websocket.receive_text(), timeout=0.01)
                message = json.loads(data)
                
                if message['type'] == 'config':
                    # Initial configuration
                    processor.model_size = message.get('model_size', 's')
                    processor.source_type = message.get('source_type', 'rtsp')
                    processor.source = message.get('source')
                    processor.regions = message.get('regions', [])
                    
                    # Load model
                    if not processor.load_model(
                        processor.model_size,
                        message.get('custom_weights')
                    ):
                        await websocket.send_json({
                            'type': 'error',
                            'message': 'Failed to load model'
                        })
                        continue
                    
                    # Open video source
                    if not processor.open_source(processor.source_type, processor.source):
                        await websocket.send_json({
                            'type': 'error',
                            'message': 'Failed to open video source'
                        })
                        continue
                    
                    processor.running = True
                    print("Configuration applied successfully")
                
                elif message['type'] == 'update_regions':
                    processor.update_regions(message.get('regions', []))
                
            except asyncio.TimeoutError:
                pass
            
            # Process and send frames
            if processor.running:
                # Check if new minute started
                current_minute = datetime.now().strftime("%H:%M")
                if counter.last_minute != current_minute:
                    if counter.last_minute is not None:
                        # Send final counts for previous minute
                        await websocket.send_json(make_json_safe({
                            'type': 'counts',
                            'counts': {
                                'total': counter.get_total_counts(),
                                'timestamp': counter.last_minute
                            }
                        }))
                    counter.reset_minute()
                    counter.last_minute = current_minute
                
                # Process frame
                frame_base64, detections = processor.process_frame()
                
                if frame_base64:
                    # Send frame with detections
                    await websocket.send_json(make_json_safe({
                        'type': 'frame',
                        'frame': frame_base64,
                        'detections': detections
                    }))
                    
                    # Send region statistics
                    await websocket.send_json(make_json_safe({
                        'type': 'region_stats',
                        'stats': counter.get_region_stats()
                    }))
                
                # Control frame rate (30 FPS)
                # await asyncio.sleep(0.033)
    
    except WebSocketDisconnect:
        print("WebSocket client disconnected")
        processor.running = False
    except Exception as e:
        print(f"WebSocket error: {e}")
    finally:
        if processor.cap:
            processor.cap.release()

def make_json_safe(obj):
    if isinstance(obj, np.generic):
        return obj.item()
    if isinstance(obj, dict):
        return {k: make_json_safe(v) for k, v in obj.items()}
    if isinstance(obj, list):
        return [make_json_safe(v) for v in obj]
    return obj

@app.get("/")
async def root():
    return {"message": "CCTV YOLO11s Tracking System API"}

@app.get("/health")
async def health():
    return {
        "status": "healthy",
        "model_loaded": processor.model is not None,
        "source_active": processor.cap is not None and processor.cap.isOpened()
    }

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)